<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Добавляем все роли -->
    <changeSet id="add-all-roles" author="malibuchka">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM roles WHERE name IN ('ROLE_ADMIN', 'ROLE_CUSTOMER', 'ROLE_ESTABLISHMENT')
            </sqlCheck>
        </preConditions>

        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_CUSTOMER"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_ESTABLISHMENT"/>
        </insert>
    </changeSet>

