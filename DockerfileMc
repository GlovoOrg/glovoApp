# Используем официальный образ MinIO Client (mc)
FROM minio/mc

# Копируем скрипты
COPY scripts/import_minio.sh /scripts/import_minio.sh

# Делаем скрипты исполняемыми
RUN chmod +x /scripts/import_minio.sh

# Ожидание и запуск скрипта после старта контейнера
ENTRYPOINT ["/bin/sh", "-c", "/scripts/import_minio.sh && tail -f /dev/null"]





