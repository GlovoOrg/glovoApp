# Используем официальный образ MinIO
FROM minio/minio

# Копируем скрипты
COPY scripts/export_minio.sh /scripts/export_minio.sh

# Делаем скрипты исполняемыми
RUN chmod +x /scripts/export_minio.sh

# Открываем консоль MinIO на порту 9001
CMD ["server", "/data/runtime", "--console-address", ":9001"]




